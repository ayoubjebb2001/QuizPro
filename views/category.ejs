<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion Catégories - Dashboard Admin</title>
   <link rel="stylesheet" href="/css/category.css">
    
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div class="logo">🎨</div>
            <h2>Dashboard Admin</h2>
        </div>
        <ul class="sidebar-menu">
            <li><a href="#"><i>📊</i> Tableau de bord</a></li>
            <li><a href="#"><i>👥</i> Utilisateurs</a></li>
            <li><a href="#"><i>📝</i> Articles</a></li>
            <li class="active"><a href="#"><i>📂</i> Catégories</a></li>
            <li><a href="#"><i>🎨</i> Thèmes</a></li>
            <li><a href="#"><i>⚙️</i> Paramètres</a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="header">
            <h1>Gestion des Catégories</h1>
            <div class="user-info">
                <img src="https://ui-avatars.com/api/?name=Admin+User&background=8B4513&color=fff" alt="Admin">
                <span>Administrateur</span>
            </div>
        </div>

        <!-- Category Form Container - Compact -->
        <div class="category-container">
            <h2>Ajouter une Catégorie</h2>
            <p class="subtitle">Entrez les informations de la catégorie</p>
            
            <form method="POST" id="categoryForm" action="/category/add">
                <div class="form-row">
                    <div class="form-group">
                        <label for="categoryName">Nom de la catégorie</label>
                        <input type="text" id="categoryName" name="name" placeholder="Nom de la catégorie" required>
                    </div>
                    <div class="form-group">
                        <label for="categoryDescription">Description</label>
                        <input type="text" id="categoryDescription" name="description" placeholder="Description courte">
                    </div>
                    <button type="submit" class="btn-submit">Ajouter</button>
                </div>
            </form>
        </div>

        <!-- Categories Table -->
        <div class="categories-table">
            <h2>Catégories existantes</h2>
            <table>
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                      
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(categories && categories.length>0){%>
                        <% categories.forEach(category=>{%>
                    <tr>
                        <td><%=category.NAME %></td>
                        <td><%=category.description%></td>
                        

                        <td>
                            <div class="action-buttons">
                              
                              <button class="btn-edit"  data-description="<%=category.description%>"data-name="<%= category.NAME %>" data-id="<%= category.id %>">Modifier</button>

                                 <button class="btn-delete" data-id="<%= category.id %>">Supprimer</button>

                            </div>
                        </td>
                    </tr>
                    <%})%>
                    <% }%>
                   
                </tbody>
            </table>
        </div>
    </div>

    <script src="/js/categories.js"></script>
</body>
</html>