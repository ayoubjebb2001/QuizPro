<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>login</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="login-container">
        <div class="login-side">
            <h1>Bienvenue</h1>
            <p>Connectez-vous pour accéder à votre espace personnel et profiter de tous nos services.</p>
        </div>
        
        <div class="form-side">
            <h2>Connexion</h2>
            <p class="subtitle">Entrez vos identifiants</p>
            
            <form id="loginForm" method="post" action="./login">
                <div class="form-group">
                    <label for="username">username</label>
                    <% if(username) { %>
                        <input type="username" id="username" name="username" value=<%= username %> required>
                    <%}else{%>
                        <input type="username" id="username" name="username"required>
                    <%}%>
                </div>
                
                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="password" placeholder="••••••••" required>
                </div>
                                
                <input type="submit" class="btn-login" value="se connecter">
                
                <div class="signup-link">
                    Pas encore de compte ? <a href="/signup">S'inscrire</a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>