<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/users.css">
    <link rel="stylesheet" href="/css/sidebar.css">
</head>

<body>
    <%- include('../partials/sidebar', {user: user}); %>

        <div class="container">
            <h1>📊 Gestion des Utilisateurs</h1>
            <p class="subtitle">Vue d'ensemble des utilisateurs et de leurs performances</p>

            <!-- Statistics Summary -->
            <div class="stats-summary">
                <div class="stat-card">
                    <h3>Total Utilisateurs</h3>
                    <div class="value">
                        <%= users.length %>
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Utilisateurs Actifs</h3>
                    <div class="value">
                        <%= users.filter(u=> u.total_games > 0).length %>
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Total Parties</h3>
                    <div class="value">
                        <%= users.reduce((sum, u)=> sum + (u.total_games || 0), 0) %>
                    </div>
                </div>
                <div class="stat-card">
                    <h3>Score Moyen Global</h3>
                    <div class="value">
                        <%=users.reduce((sum,u)=> sum + Number(u.average_score || 0),0 )/
                            users.filter((u) => u.average_score ).length %>
                        %>%
                    </div>
                </div>
            </div>

            <!-- Users Table -->
            <div class="users-table-container">
                <div class="table-header">
                    <h2>Liste des Utilisateurs</h2>
                </div>

                <% if (users && users.length> 0) { %>
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nom d'utilisateur</th>
                                <th>Rôle</th>
                                <th class="text-center">Parties Jouées</th>
                                <th class="text-center">Score Moyen</th>
                                <th class="text-center">Meilleur Score</th>
                                <th class="text-center">Pire Score</th>
                                <th>Dernière Partie</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(u) { %>
                                <tr>
                                    <td><strong>#<%= u.id %></strong></td>
                                    <td><strong>
                                            <%= u.username %>
                                        </strong></td>
                                    <td>
                                        <span class="role-badge role-<%= u.ROLE %>">
                                            <%= u.ROLE %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <%= u.total_games || 0 %>
                                    </td>
                                    <td class="text-center">
                                        <% if (u.average_score) { %>
                                            <span
                                                class="score-cell <%= u.average_score >= 70 ? 'score-high' : u.average_score >= 50 ? 'score-medium' : 'score-low' %>">
                                                <%= u.average_score %>%
                                            </span>
                                            <% } else { %>
                                                <span class="text-muted">—</span>
                                                <% } %>
                                    </td>
                                    <td class="text-center">
                                        <% if (u.best_score) { %>
                                            <span class="score-cell score-high">
                                                <%= u.best_score %>%
                                            </span>
                                            <% } else { %>
                                                <span class="text-muted">—</span>
                                                <% } %>
                                    </td>
                                    <td class="text-center">
                                        <% if (u.worst_score) { %>
                                            <span class="score-cell score-low">
                                                <%= u.worst_score %>%
                                            </span>
                                            <% } else { %>
                                                <span class="text-muted">—</span>
                                                <% } %>
                                    </td>
                                    <td>
                                        <% if (u.last_played) { %>
                                            <span class="text-muted">
                                                <%= new Date(u.last_played).toLocaleDateString('fr-FR', {
                                                    year: 'numeric' , month: 'short' , day: 'numeric' }) %>
                                            </span>
                                            <% } else { %>
                                                <span class="text-muted">Jamais joué</span>
                                                <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                        </tbody>
                    </table>
                    <% } else { %>
                        <div class="no-data">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                            <p>Aucun utilisateur trouvé</p>
                        </div>
                        <% } %>
            </div>
        </div>

        <script src="/js/sidebar.js"></script>
</body>

</html>