<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %> - <%= category ? category.NAME : 'Quiz' %>
    </title>
    <link rel="stylesheet" href="/css/quiz.css" />
</head>

<body>
    <%- include('../partials/navbar',{user:user}); %>
        <div class="wrapper">
            <% if(error){ %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
                <% } %>
                    <% if(category){ %>
                        <div class="header-bar">
                            <div>
                                <h1>
                                    <%= category.NAME %>
                                </h1>
                                <div class="meta">
                                    <%= category.description || 'Répondez aux questions ci-dessous.' %>
                                </div>
                            </div>
                            <div class="category-pill">CAT #<%= category.id %>
                            </div>
                        </div>
                        <% } %>

                            <% if(questions && questions.length){ %>
                                <form id="quizForm" method="POST" action="/quiz/submit">
                                    <% questions.forEach(function(q,idx){ %>
                                        <div class="question-card" data-question-id="<%= q.id %>">
                                            <div class="progress">Question <%= idx+1 %> / <%= questions.length %>
                                            </div>
                                            <h2 class="question-title">
                                                <%= q.question %>
                                            </h2>
                                            <ul class="options">
                                                <% q.options.forEach(function(opt,optIdx){ %>
                                                    <li>
                                                        <label class="option-label">
                                                            <input type="radio" name="q_<%= q.id %>" value="<%= opt %>"
                                                                required>
                                                            <span>
                                                                <%= opt %>
                                                            </span>
                                                        </label>
                                                    </li>
                                                    <% }) %>
                                            </ul>
                                        </div>
                                        <% }) %>
                                            <div class="actions">
                                                <a href="/quiz/start" class="btn btn-outline">⟵ Retour</a>
                                                <button type="submit" class="btn btn-primary">Soumettre mes
                                                    réponses</button>
                                            </div>
                                </form>
                                <% } else if(!error){ %>
                                    <div class="empty">Aucune question disponible pour cette catégorie pour le moment.
                                    </div>
                                    <% } %>
        </div>

        <script src="../../js/navbar.js">
        </script>
</body>

</html>