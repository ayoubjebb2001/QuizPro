<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/categoryQ.css">

</head>

<body>

    <%- include('../partials/navbar',{user,user}); %>

        <div class="container">

            <div class="quiz-grid">
                <%if(categories && categories.length>0){%>
                    <% categories.forEach(category=>{%>
                        <div class="quiz-card">
                            <h2>
                                <%=category.NAME%>
                            </h2>
                            <p>
                                <%=category.description%>
                            </p>
                            <button class="start-btn" data-id="<%=category.id%>">Start Quiz</button>
                        </div>
                        <%})%>
                            <%}%>


            </div>
        </div>

        <script src="../../js/navbar.js"></script>
        <script>
            document.querySelectorAll('.start-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.getAttribute('data-id');
                    if (id) window.location.href = `/quiz/category/${id}`;
                });
            });
        </script>
</body>

</html>