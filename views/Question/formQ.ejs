<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ajouter une Question</title>
    <link rel="stylesheet" href="/css/formQ.css">



</head>

<body>

    <div class="container">
        <div class="form-card">
            <div class="form-header">
                <h1>Question</h1>
                <p>Fill the form to create a question</p>
            </div>

            <form id="questionForm">
                <% const existingQuestion=questions && questions[0] ? questions[0] : null; %>
                    <% const existingOptions=existingQuestion && Array.isArray(existingQuestion.options) ?
                        existingQuestion.options : []; %>
                        <% const existingAnswers=existingQuestion && Array.isArray(existingQuestion.answer) ?
                            existingQuestion.answer : []; %>

                            <div class="form-group">
                                <label for="question">Question</label>
                                <textarea id="question" name="question" placeholder="Your question text goes here"
                                    required><%= existingQuestion ? existingQuestion.question : '' %></textarea>
                            </div>

                            <div class="form-group">
                                <label for="category">Category</label>
                                <select id="category" name="category_id" required>
                                    <% categories.forEach(cat=> { %>
                                        <option value="<%= cat.id %>" <%=existingQuestion &&
                                            Number(existingQuestion.category_id)===Number(cat.id) ? 'selected' : '' %>>
                                            <%= cat.NAME %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>

                            <div class="form-group">
                                <label>Answer</label>
                                <div id="answersContainer">
                                    <% if (existingOptions.length> 0) { %>
                                        <% existingOptions.forEach((op)=> { %>
                                            <div class="answer-item">
                                                <input type="text" placeholder="answer goes here" value="<%= op %>"
                                                    class="answer-input" required>
                                                <button type="button" class="btn-remove">Remove</button>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <div class="answer-item">
                                                        <input type="text" placeholder="answer goes here"
                                                            class="answer-input" required>
                                                        <button type="button" class="btn-remove">Remove</button>
                                                    </div>
                                                    <% } %>
                                </div>

                                <button type="button" class="btn-add" id="addAnswerBtn">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                        stroke="currentColor">
                                        <circle cx="12" cy="12" r="10" stroke-width="2" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8v8m-4-4h8" />
                                    </svg>
                                    add answer
                                </button>
                            </div>

                            <div class="form-group">
                                <label>Correct Answers</label>
                                <p class="helper-text">choose one or more options</p>
                                <div id="correctAnswersContainer">
                                    <% if (existingOptions.length> 0) { %>
                                        <% existingOptions.forEach((op, index)=> { %>
                                            <% const isChecked=existingAnswers.includes(op) ||
                                                existingAnswers.includes(index) ||
                                                existingAnswers.includes(String(index)); %>
                                                <div class="checkbox-group">
                                                    <input type="checkbox" id="correct<%= index+1 %>" value="<%= op %>"
                                                        <%=isChecked ? 'checked' : '' %>>
                                                    <label for="correct<%= index+1 %>">answer <%= index+1 %></label>
                                                </div>
                                                <% }) %>
                                                    <% } else { %>
                                                        <div class="checkbox-group">
                                                            <input type="checkbox" id="correct1" value="">
                                                            <label for="correct1">answer 1</label>
                                                        </div>
                                                        <% } %>
                                </div>
                            </div>
                            <input type="hidden" id="questionId"
                                value="<%= questions && questions[0] ? questions[0].id : '' %>">




                            <button type="submit" class="btn-save">Save Question</button>
            </form>
        </div>
    </div>
    <!-- <script src="/js/formQ.js"></script> -->
    <script src="/js/formQ.js"></script>
</body>

</html>