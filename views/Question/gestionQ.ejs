<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion Questions - Dashboard Admin</title>
  <link rel="stylesheet" href="/css/gestionQ.css">
   
</head>
<body>
<%- include('../partials/sidebar') %>

    <!-- Main Content -->
    <div class="main-content">
        <div class="header">
            <h1>Gestion des Questions</h1>
            <div class="user-info">
                <img src="https://ui-avatars.com/api/?name=Admin+User&background=8B4513&color=fff" alt="Admin">
                <span>Administrateur</span>
            </div>
        </div>
<div class="add-question-btn">
        <a href="/question/add" class="btn-add-question">Ajouter une Question</a>
    </div>

        <div class="questions-table">
            <h2>Questions existantes</h2>
            <table>
                <thead>
                    <tr>
                        <th>Question</th>
                        <th>Catégorie</th>

                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                  <% if (questions && questions.length > 0) { %>
    <% questions.forEach(q => { %>
        <tr>
            <td><%= q.question %></td>
            <td><%= q.name %></td>
          
            <td>
               
                <div class="action-buttons">
 <button class="btn-edit" data-id="<%= q.id %>">Modifier</button>
         <button class="btn-delete" data-id="<%= q.id %>">Supprimer</button>
                </div>
            </td>
        </tr>
    <% }) %>
<% } %>

                </tbody>
            </table>
        </div>
    </div>
    
    <script src="/js/gestionQ.js"></script>
</body>
</html>