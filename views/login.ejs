<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        
    </title>
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>
    <div class="login-container">
        <div class="login-side">
            <h1>Bienvenue</h1>
            <p>Connectez-vous pour accéder à votre espace personnel et profiter de tous nos services.</p>
        </div>

        <div class="form-side">
            <h2>Connexion</h2>
            <p class="subtitle">Entrez vos identifiants</p>

            <!-- Display error message if exists -->
            <% if (typeof errorMessage !=='undefined' && errorMessage) { %>
                <div class="alert alert-error">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    <%= errorMessage %>
                </div>
                <% } %>

                    <form id="loginForm" method="post" action="./login">
                        <div class="form-group">
                            <label for="username">username</label>
                            <% if(username) { %>
                                <input type="username" id="username" name="username" value=<%=username %> required>
                                <%}else{%>
                                    <input type="username" id="username" name="username" required>
                                    <%}%>
                        </div>

                        <div class="form-group">
                            <label for="password">Mot de passe</label>
                            <input type="password" id="password" name="password" placeholder="••••••••" required>
                        </div>

                        <input type="submit" class="btn-login" value="se connecter">

                        <div class="signup-link">
                            Pas encore de compte ? <a href="/signup">S'inscrire</a>
                        </div>
                    </form>
        </div>
    </div>

</body>

</html>